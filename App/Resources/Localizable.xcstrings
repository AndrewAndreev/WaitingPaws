    "Waiting Paws collects nothing and sends nothing to the developer: settings, logs and videos stay on your devices." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting Paws ничего не собирает и не отправляет разработчику: настройки, логи и видео остаются на ваших устройствах."
          }
        }
      }
    },
    "Waiting Paws on an iPhone on the same Wi‑Fi network can see this Mac." : {
      "localizations" : {
