        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera, recording and log stay on the Mac, while the iPhone runs the training from behind the door. The iPhone reconnects by itself to the last Mac it worked with. The Mac sees the name above when the iPhone connects."
          }
        },
        "ru" : {
